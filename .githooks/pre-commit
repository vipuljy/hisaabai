#!/bin/sh
# Runs before every commit (enabled by SETUP_github.bat: git config core.hooksPath .githooks)
PY=$(command -v python || command -v python3 || command -v py)
if [ -z "$PY" ]; then
  echo "Python not found: secret scan skipped. Commit blocked to be safe."
  exit 1
fi
"$PY" scripts/secret_scan.py || { echo "Commit blocked by the secret scan (see above)."; exit 1; }
