# Copy this file to .env and fill in your values. Never share .env, never paste it into any chat.
# After filling it in, double-click RUN_check_setup.bat: it tests every value without showing it.

# Meta app > WhatsApp > API Setup > "Generate access token" (temporary, ~24h).
# Later replace with the permanent System User token (Meta Step 6).
WHATSAPP_TOKEN=paste-your-access-token-here

# Meta app > WhatsApp > API Setup > "Phone number ID" (not the phone number itself)
PHONE_NUMBER_ID=paste-your-phone-number-id-here

# Make up any long random string. Type the same one in Meta > WhatsApp > Configuration > Verify token
VERIFY_TOKEN=make-up-any-long-random-string

# Meta app > App settings > Basic > App secret. Optional, but turns on signature checks.
APP_SECRET=

# Match the API version shown on the API Setup page
GRAPH_VERSION=v23.0

# Optional: WhatsApp Business account ID (API Setup page). Lets RUN_check_setup.bat show template approval status.
WABA_ID=

# Phase 2: bill reading (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# Which model reads bills, and which prompt version (see src/eval_config.json and docs/08_eval.md)
BILL_MODEL=claude-haiku-5-5
BILL_PROMPT=v3

# How bill photos are read (docs/13_cascade_spec.md, step 9). P5 = Haiku reads, free checks on its answer
# (OCR total, proofs, unsure fields, sanity); Sonnet re-reads only when a check on the TOTAL fails; a doubtful
# date / invoice no. is asked to the owner (date: one tap). Other values: haiku (one read, no checks), P1, P2,
# P3 (Sonnet for any failed check; the owner checks total / date if the two readers still disagree).
# Default P5_no_ocr = P5 without the OCR checks (live on Render free, 512 MB, no RapidOCR).
# P5_trusted_ocr = P5 that trusts only a PROVED OCR total (Oracle VM with RapidOCR + OCR_CHECK=1).
READ_POLICY=P5_no_ocr
ESCALATION_MODEL=claude-sonnet-5-5
# How much the AI thinks before answering (bot/ai_client.py): low, medium, high, off (Haiku only), or empty for the
# model's default (Haiku medium, Sonnet high). Less thinking = a faster reply. Change only after RUN_eval_speed.bat
# shows accuracy holds (rule in docs/08_eval.md). BILL_EFFORT = Haiku's first read; ESCALATION_EFFORT = Sonnet's re-read.
BILL_EFFORT=
ESCALATION_EFFORT=
# 0 = skip the free RapidOCR check (needs requirements-ocr-bot.txt, in the Docker image; about 1 GB RAM)
OCR_CHECK=1

# Questions about the hisaab are understood by rules + a WhatsApp list menu. Set to 1 to also let Haiku
# CLASSIFY unclear questions (it picks a question type only; numbers always come from the database).
# Needs ANTHROPIC_API_KEY; each use counts towards the daily AI caps. Leave 0 to measure rules + menu alone.
QA_LLM=0

# Phase 2: database. Supabase > Connect > Session pooler > URI (with your DB password filled in).
# Leave empty to keep data in memory (fine for the test number; lost on restart).
DATABASE_URL=

# Photos in a PRIVATE Supabase bucket (needed once the bot is hosted). Supabase > Project settings > API keys.
# SUPABASE_SERVICE_KEY is the secret (or service_role) key: it can read everything, so it lives only here and on the host.
# Leave both empty: photos stay in data/raw/bills/ on this laptop.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PHOTO_BUCKET=bill-photos

# Voice notes (sarvam.ai > dashboard > API keys). Leave empty: the bot asks owners to type instead.
SARVAM_API_KEY=
# 1 (default) = a voice note the rules cannot read goes to one small Haiku call that may fill cards (the owner still
# confirms each). 0 = rules only (cheaper; unread notes get "Maine suna: ..." and an example).
VOICE_LLM=1

# Language the two templates were approved under (docs/10_templates.md): en or hi
TEMPLATE_LANGUAGE=en

# 1 = any number that messages the bot becomes a test shop. Use ONLY with Meta's test number.
# Empty = invite-only: shops are added with `python -m bot.admin add-shop ...`
PILOT_OPEN=1

# Cost and abuse guards (each bill photo or voice note = 1 AI call). Also set a monthly spend limit in the Anthropic console.
AI_CALLS_PER_SHOP_PER_DAY=60
AI_CALLS_PER_DAY=1000
MAX_IMAGE_MB=8
MAX_PDF_MB=10
# Hosts that wipe their disk (Render): 1 = /health fails unless bills go to Postgres and photos to Supabase
REQUIRE_PERSISTENT_STORAGE=0

# Only on the host: 24+ random characters. The daily scheduler sends it to POST /jobs/daily (docs/11_setup_and_hosting.md).
JOBS_TOKEN=
